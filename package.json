{
  "name": "@xeplr/email",
  "version": "1.0.7",
  "description": "Email for xeplr apps — SMTP, AWS SES, Azure or Brevo, sent in-process or over HTTP, with an optional queue and a template store",
  "main": "index.js",
  "files": [
    "index.js",
    "lib/",
    "models/",
    "migrations/",
    "bin/",
    "embed/"
  ],
  "keywords": [
    "email",
    "http",
    "internal",
    "smtp",
    "ses",
    "brevo"
  ],
  "author": "xeplr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xeplr/xeplr-email"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xeplr/base-apis": "^2.0.0",
    "@xeplr/db": "^1.0.0",
    "@xeplr/utils": "^1.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:embed": "esbuild embed/embed.js --minify --target=es2017 --legal-comments=inline --outfile=embed/embed.min.js"
  },
  "bin": {
    "xeplr-email-public": "bin/xeplr-email-public.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
